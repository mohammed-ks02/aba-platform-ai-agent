# ABA Fusion AI Agent -- environment configuration
# Copy this file to `.env` in the project root and fill in real values.
# The agent auto-loads `.env` on startup (no `set`/`export` needed).

# --- ABA Fusion staging login (used by token_manager.py for JWT auth) ---
ABA_USERNAME=test_02
ABA_PASSWORD=your_staging_password_here
ABA_TENANT=arma

# --- LLM providers (at least one; both are OpenAI-compatible) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Which provider/model the agent uses by default ---
ABA_LLM_PROVIDER=groq
ABA_LLM_MODEL=qwen/qwen3.8-27b

# --- Optional overrides ---
# ABA_AGENT_DATA_DIR=/path/to/data     # where memory.db + reports live
# ABA_UI_HOST=127.0.0.1                # web UI bind host
# ABA_UI_PORT=8787                     # web UI port
# OPENAI_API_KEY=sk-...                # other providers work too
